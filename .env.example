# Values in config.yaml are non-secret defaults. Supply these secrets as
# process environment variables; Viper does not load this file automatically.
MYSQL_PASSWORD=replace-with-your-mysql-password
MINIO_ACCESS_KEY=replace-with-your-minio-access-key
MINIO_SECRET_KEY=replace-with-your-minio-secret-key
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# Optional when Redis requires authentication:
# REDIS_PASSWORD=replace-with-your-redis-password

# Optional compatibility override for an existing installation:
# MYSQL_DSN=user:password@tcp(127.0.0.1:3307)/govault?parseTime=true
